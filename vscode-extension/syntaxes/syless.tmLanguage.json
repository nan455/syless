{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SYLESS",
  "scopeName": "source.syless",
  "fileTypes": ["sy"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords-control" },
    { "include": "#keywords-statement" },
    { "include": "#keywords-dsa" },
    { "include": "#keywords-ml" },
    { "include": "#keywords-logical" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.syless",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.syless",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.syless", "match": "\\\\." },
            { "name": "variable.other.interpolated.syless", "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}" }
          ]
        },
        {
          "name": "string.quoted.single.syless",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.syless", "match": "\\\\." },
            { "name": "variable.other.interpolated.syless", "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}" }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.syless",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "constants": {
      "name": "constant.language.syless",
      "match": "\\b(true|false|null|nothing)\\b"
    },
    "keywords-control": {
      "name": "keyword.control.syless",
      "match": "\\b(check|also|otherwise|else|loop|times|repeat|while|for|each|in)\\b"
    },
    "keywords-statement": {
      "name": "keyword.other.declaration.syless",
      "match": "\\b(say|show|make|ask|task|give)\\b"
    },
    "keywords-dsa": {
      "name": "keyword.other.dsa.syless",
      "match": "\\b(push|pop|into|from|insert|remove|add|sort|ascending|descending|binary|search|connect|to)\\b"
    },
    "keywords-ml": {
      "name": "keyword.other.ml.syless",
      "match": "\\b(train|predict|evaluate|load|on|with|as)\\b"
    },
    "keywords-logical": {
      "name": "keyword.operator.logical.syless",
      "match": "\\b(and|or|not)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.syless",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.syless",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.syless",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.assignment.compound.syless",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.arithmetic.syless",
          "match": "(\\*\\*|[+\\-*/%])"
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.syless",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "identifiers": {
      "name": "variable.other.syless",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
