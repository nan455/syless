{
  "name": "syless-language",
  "displayName": "SYLESS Language",
  "description": "Syntax highlighting, snippets, and run support for the SYLESS programming language",
  "version": "0.8.0",
  "publisher": "syless",
  "icon": "icon.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": ["syless", "language", "syntax", "highlighting"],
  "repository": {
    "type": "git",
    "url": "https://github.com/syless/syless-vscode"
  },
  "activationEvents": [
    "onLanguage:syless"
  ],
  "contributes": {
    "languages": [
      {
        "id": "syless",
        "aliases": ["SYLESS", "syless", "Syless"],
        "extensions": [".sy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "syless",
        "scopeName": "source.syless",
        "path": "./syntaxes/syless.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "syless",
        "path": "./snippets/syless.json"
      }
    ],
    "commands": [
      {
        "command": "syless.runFile",
        "title": "Run SYLESS File",
        "icon": "$(play)",
        "category": "SYLESS"
      }
    ],
    "keybindings": [
      {
        "command": "syless.runFile",
        "key": "f5",
        "when": "editorLangId == syless"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "syless.runFile",
          "when": "editorLangId == syless",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "syless.runFile",
          "when": "editorLangId == syless",
          "group": "navigation"
        }
      ]
    }
  }
}
