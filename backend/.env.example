# ─── Database (MySQL) ────────────────────────────────────────────────────────
# Local development:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=syless_db
DB_USER=root
DB_PASSWORD=nanda

# Hostinger (replace with your actual values from Hostinger control panel):
# DB_HOST=your-hostinger-db-host.hostinger.com
# DB_PORT=3306
# DB_NAME=u123456789_syless
# DB_USER=u123456789_syless
# DB_PASSWORD=YourHostingerDBPassword

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_min32chars
JWT_EXPIRES_IN=7d

# ─── AI (Free Tier) ──────────────────────────────────────────────────────────
# Groq — FREE: 14,400 requests/day, 6,000 tokens/min
# Sign up at: https://console.groq.com (completely free, no credit card)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gemini — FREE: 1,500 requests/day (fallback if Groq fails)
# Sign up at: https://aistudio.google.com/app/apikey (completely free)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS — update for production)
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
